# ---------------------------------------------------------------------------
# Copy to .env.local for local dev, and add the same keys in Vercel
# (Project -> Settings -> Environment Variables) to save form submissions.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Either key works, but the service role key is preferred for server-side inserts.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Canonical site URL used for metadata, sitemap.xml and robots.txt.
# Leave blank on Vercel and it will auto-detect the deployment URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
